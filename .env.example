# Set the confirmed HTTPS domain before deployment. No domain has been supplied.
# NEXT_PUBLIC variables are public and included at build time. Never put secrets here.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# Server-only lead endpoint. Required to enable form submission.
# In production, use HTTPS and the accepted:true response contract in README.md.
LEAD_API_URL=
LEAD_API_TOKEN=

# Required shared production rate limiter when submissions are connected.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Only enable if your trusted hosting proxy overwrites x-forwarded-for.
TRUST_PROXY=false

# Disabled by default; additionally requires an explicit stored consent choice.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
